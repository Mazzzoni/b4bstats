# .env.local of the production server (mazzvps): copy to .env.local, fill the empty values from Bitwarden
# (Mazz/Servers › mazzvps · ~/projects/b4bstats.mazz.lol/.env.local), never commit it. The build reads it as a
# BuildKit secret and the container as its env_file.

# Self-hosted Plausible: origin and site name (public, inlined in the bundle).
NEXT_PUBLIC_PLAUSIBLE_URL=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# The API behind the same-origin /api/game proxy, and the proxy's shared token (b4bstats-api WEBSITE_PROXY_TOKEN).
B4BSTATS_API_URL=
B4BSTATS_PROXY_TOKEN=

# Proxy addresses trusted to name the client IP.
B4BSTATS_TRUSTED_PROXIES=
