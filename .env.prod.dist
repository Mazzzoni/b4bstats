# Compose settings of the production server (mazzvps): copy to .env next to compose.yaml, never commit .env.
# No secret here (the site's settings are in .env.local).

# Production overlay (restart policy, log rotation).
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# The compose project name the server has always used (it names the container and the image).
COMPOSE_PROJECT_NAME=b4bstatsmazzlol

# Port Caddy proxies to (127.0.0.1).
WEB_PORT=8487
